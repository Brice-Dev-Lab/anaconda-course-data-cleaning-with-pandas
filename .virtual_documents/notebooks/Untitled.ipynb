def read_text(filepath):
    with open(filepath) as f:
        return f.readlines()





read_text('maintenance.csv')





pd.read_csv('maintenance.csv')





import sqlite3

conn = sqlite3.connect('company_operations.db')

pd.read_sql("SELECT * FROM CUSTOMER", conn)





